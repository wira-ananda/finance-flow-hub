{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["google-apps-script"],

    "strict": true,
    "noImplicitAny": true,
    "noEmitOnError": true,

    "rootDir": "src",
    "outDir": "dist",

    "removeComments": false,
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
